# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Email Configuration (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# JWT Secret for Admin Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# Socket.io Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Portfolio Configuration
NEXT_PUBLIC_PORTFOLIO_NAME=Your Portfolio Name

# Image Upload - Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dbu5uajzc
CLOUDINARY_API_KEY=729252515647838
CLOUDINARY_API_SECRET=mGND__9yA5cVjMilRWrUCK3h4rY
CLOUDINARY_URL=cloudinary://729252515647838:mGND__9yA5cVjMilRWrUCK3h4rY@dbu5uajzc
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dbu5uajzc

# Video Conversion - Transloadit (FREE 10GB/month)
# Get credentials from: https://transloadit.com/c/template-credentials/
TRANSLOADIT_KEY=your_auth_key_here
TRANSLOADIT_SECRET=your_auth_secret_here

# Alternative: Vercel Blob Storage
# BLOB_READ_WRITE_TOKEN=your_token

# Alternative: AWS S3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=your_region
# S3_BUCKET_NAME=your_bucket

# AI Video Studio: one-click posting through Buffer (https://publish.buffer.com/settings/api)
BUFFER_API_KEY=your_buffer_api_key
# Optional: only if auto-detecting your organization fails
# BUFFER_ORGANIZATION_ID=
# Password the Studio asks for before it uploads/posts anything (choose your own)
STUDIO_PUBLISH_PASSWORD=choose-a-strong-password

# Daily content pack (Vercel cron) + image generation with reference images. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key
# Vercel Cron sends this automatically as an Authorization Bearer header. Any long random string.
CRON_SECRET=long-random-string
# Optional: DAILY_PACK_SCENES=7  DAILY_PACK_LANGUAGE=roman_urdu  GEMINI_MODEL=gemini-2.5-flash
